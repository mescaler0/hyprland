#!/bin/bash
# $1 deve essere "volume" o "mic"
WINDOW="${1}_bar"
OTHER=$([ "$1" == "volume" ] && echo "mic_bar" || echo "volume_bar")

# Chiudi l'altra solo se è effettivamente aperta (evita l'errore in console)
if eww active-windows | grep -q "$OTHER"; then
    eww close "$OTHER"
fi

# Alterna quella cliccata
eww open --toggle "$WINDOW"

